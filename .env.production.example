# Production secrets for the OctopusTech stack. On the server:
#   cp .env.production.example .env && nano .env && chmod 600 .env
# Never commit .env.

# Admin panel (/admin). Required: with no value, every admin login is refused.
ADMIN_PASSWORD=

# AI assistant (primary provider)
ANTHROPIC_API_KEY=

# AI fallback provider (optional; leave empty to run on the primary only)
META_API_KEY=

# Octo's cloned voice (optional; both needed)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Host port the web container binds on 127.0.0.1 (change if 3200 is taken on the server)
# WEB_PORT=3200

# Optional AI budget overrides (defaults in backend/app/ai/limits.py and muse.py)
# AI_TOTAL_BUDGET_USD=4.50
# AI_DAILY_BUDGET_USD=0.50
# MUSE_TOTAL_BUDGET_USD=100
# MUSE_DAILY_BUDGET_USD=5
