# Copy this file to .env and fill in real values. Never commit .env.

# --- Admin panel (/admin) ---
# Required: with no value, every admin login is refused.
ADMIN_PASSWORD=

# --- AI demo (Ask the Octopus + 5 Ws Project Scoper) ---
# Use a key from a dedicated Anthropic Console workspace with a spend limit (e.g. $5).
ANTHROPIC_API_KEY=

# --- Octo's voice (Abdulla's cloned voice via ElevenLabs) ---
# Leave empty to keep Octo silent. Both are needed.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v4_turbo
# VOICE_SITE_DAILY_CHARS=30000     # whole site, per day
# VOICE_PER_IP_DAILY_CHARS=4000    # per visitor, per day

# --- Muse on the Meta Model API (Octo's fallback + model evaluations) ---
# Key from https://dev.meta.ai. Leave empty to run on Claude only.
META_API_KEY=
# MUSE_MODEL=muse-spark-1.3
# MUSE_TOTAL_BUDGET_USD=100     # hard stop on Meta credits spent by this app
# MUSE_DAILY_BUDGET_USD=5
# MUSE_PRICE_INPUT_PER_MTOK=1.25   # set exact prices from your Meta dashboard
# MUSE_PRICE_OUTPUT_PER_MTOK=4.25

# Optional overrides (defaults shown)
# AI_MODEL=claude-haiku-5-5
# AI_TOTAL_BUDGET_USD=4.50      # stop serving at this total estimated spend
# AI_DAILY_BUDGET_USD=0.50      # stop serving at this estimated spend per day
# AI_PER_IP_HOURLY=20           # messages per visitor per hour
# AI_PER_IP_DAILY=60            # messages per visitor per day
# AI_MAX_MESSAGE_CHARS=800
# AI_TRUST_PROXY=false          # set true behind nginx so visitor IPs come from X-Forwarded-For
